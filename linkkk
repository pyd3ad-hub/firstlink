-- Emergency toggle functionality - toggles both invis and fly at the same time
emergencyButton.MouseButton1Click:Connect(function()
	-- Get functions and variables (they should be global from z.lua)
	local startInvis = startInvisibility or _G.startInvisibility
	local stopInvis = stopInvisibility or _G.stopInvisibility
	local enableFlyFunc = enableFly or _G.enableFly
	local disableFlyFunc = disableFly or _G.disableFly
	
	if not (startInvis and stopInvis and enableFlyFunc and disableFlyFunc) then
		warn("Emergency button: Invisibility/Fly functions not found. Make sure z.lua is loaded first.")
		return
	end
	
	-- Get current states - access from global scope
	local playerUtils = PlayerUtilities or _G.PlayerUtilities
	local invisState = false
	local flyState = false
	
	if playerUtils then
		invisState = playerUtils.Invisibility or false
	end
	
	-- Try multiple ways to get flyEnabled
	if _G.flyEnabled ~= nil then
		flyState = _G.flyEnabled
	elseif flyEnabled ~= nil then
		flyState = flyEnabled
	end
	
	-- Determine target state: if both are on, turn both off; otherwise turn both on
	local targetState = not (invisState and flyState)
	
	-- Toggle invisibility
	if playerUtils then
		playerUtils.Invisibility = targetState
	end
	
	-- Update flyEnabled in global scope
	if _G.flyEnabled ~= nil then
		_G.flyEnabled = targetState
	elseif flyEnabled ~= nil then
		flyEnabled = targetState
		-- Also set in _G for cross-script access
		_G.flyEnabled = targetState
	end
	
	-- Call the functions
	if targetState then
		pcall(function() 
			if startInvis then startInvis() end
			if enableFlyFunc then enableFlyFunc() end
		end)
	else
		pcall(function() 
			if stopInvis then stopInvis() end
			if disableFlyFunc then disableFlyFunc() end
		end)
	end
	
	-- Update UI state if toggleElements exists (for updating the visual toggles)
	if _G.toggleElements and type(_G.toggleElements) == "table" then
		-- Update invisibility toggle (index 5)
		if _G.playerUtilitiesData and _G.playerUtilitiesData[5] then
			_G.playerUtilitiesData[5].Enabled = targetState
			local invisElement = _G.toggleElements[5]
			if invisElement and invisElement.switchContainer and invisElement.toggleSlider and invisElement.statusIndicator then
				local targetPosition = targetState and UDim2.new(1, -17, 0, 1) or UDim2.new(0, 1, 0, 1)
				local targetBgColor = Color3.fromRGB(25, 25, 25)
				local targetStrokeColor = targetState and Color3.fromRGB(15, 15, 15) or Color3.fromRGB(25, 25, 25)
				local targetSymbol = targetState and "◉" or "○"
				
				TweenService:Create(invisElement.toggleSlider, TweenInfo.new(0.2), {Position = targetPosition}):Play()
				TweenService:Create(invisElement.switchContainer, TweenInfo.new(0.2), {BackgroundColor3 = targetBgColor}):Play()
				if invisElement.switchContainer.UIStroke then
					TweenService:Create(invisElement.switchContainer.UIStroke, TweenInfo.new(0.2), {Color = targetStrokeColor}):Play()
				end
				invisElement.statusIndicator.Text = targetSymbol
			end
		end
		
		-- Update fly toggle (index 6)
		if _G.playerUtilitiesData and _G.playerUtilitiesData[6] then
			_G.playerUtilitiesData[6].Enabled = targetState
			local flyElement = _G.toggleElements[6]
			if flyElement and flyElement.switchContainer and flyElement.toggleSlider and flyElement.statusIndicator then
				local targetPosition = targetState and UDim2.new(1, -17, 0, 1) or UDim2.new(0, 1, 0, 1)
				local targetBgColor = Color3.fromRGB(25, 25, 25)
				local targetStrokeColor = targetState and Color3.fromRGB(15, 15, 15) or Color3.fromRGB(25, 25, 25)
				local targetSymbol = targetState and "◉" or "○"
				
				TweenService:Create(flyElement.toggleSlider, TweenInfo.new(0.2), {Position = targetPosition}):Play()
				TweenService:Create(flyElement.switchContainer, TweenInfo.new(0.2), {BackgroundColor3 = targetBgColor}):Play()
				if flyElement.switchContainer.UIStroke then
					TweenService:Create(flyElement.switchContainer.UIStroke, TweenInfo.new(0.2), {Color = targetStrokeColor}):Play()
				end
				flyElement.statusIndicator.Text = targetSymbol
			end
		end
	end
	
	-- Visual feedback - flash the button
	local originalColor = emergencyButton.BackgroundColor3
	TweenService:Create(emergencyButton, TweenInfo.new(0.1), {
		BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	}):Play()
	task.wait(0.1)
	TweenService:Create(emergencyButton, TweenInfo.new(0.1), {
		BackgroundColor3 = originalColor
	}):Play()
end)

-- Long Press / Long Click Detection
local longPressThreshold = 0.01
local keyPressTimes = {}

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	for _, keyData in pairs(keys) do
		-- Skip F button as it has its own toggle logic
		if keyData.Name ~= "F" then
			if (keyData.KeyCode and input.KeyCode == keyData.KeyCode) or 
			   (keyData.InputType and input.UserInputType == keyData.InputType) then
				local button = buttons[keyData.Name]
				if button then
					keyPressTimes[keyData.Name] = tick()
					-- Immediately change text to grey
					TweenService:Create(button, TweenInfo.new(0.1), {TextColor3 = Color3.fromRGB(128, 128, 128)}):Play()
					task.spawn(function()
						task.wait(longPressThreshold)
						if keyPressTimes[keyData.Name] then
							TweenService:Create(button, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(30, 30, 30)}):Play()
						end
					end)
					
				end
			end
		end
	end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	for _, keyData in pairs(keys) do
		-- Skip F button as it has its own toggle logic
		if keyData.Name ~= "F" then
			if (keyData.KeyCode and input.KeyCode == keyData.KeyCode) or 
			   (keyData.InputType and input.UserInputType == keyData.InputType) then
				local button = buttons[keyData.Name]
				if button and keyPressTimes[keyData.Name] then
					local pressDuration = tick() - keyPressTimes[keyData.Name]
					keyPressTimes[keyData.Name] = nil
					if pressDuration < longPressThreshold then
						TweenService:Create(button, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(255, 255, 255), TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
						task.wait(0.1)
						TweenService:Create(button, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(50, 50, 50), TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
					else
						TweenService:Create(button, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(50, 50, 50), TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
					end
				end
			end
		end
	end
end)

-- Draggify GUI Functionality for Main Frame (Mobile Compatible)
local dragging = false
local dragInput, dragStart, startPos

Frame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = Frame.Position
		
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
				
				-- Save position when drag ends
				savedPositions["KeystrokeUI_Frame"] = {
					Xs = Frame.Position.X.Scale,
					Xo = Frame.Position.X.Offset,
					Ys = Frame.Position.Y.Scale,
					Yo = Frame.Position.Y.Offset
				}
				saveConfig()
			end
		end)
	end
end)

Frame.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and input == dragInput then
		local delta = input.Position - dragStart
		Frame.Position = UDim2.new(
			startPos.X.Scale, 
			startPos.X.Offset + delta.X, 
			startPos.Y.Scale, 
			startPos.Y.Offset + delta.Y
		)
	end
end)

-- Fling functionality
local hiddenfling = true  -- On by default

-- Detection marker already created above

-- Fling function
local function fling()
	local hrp, c, vel, movel = nil, nil, nil, 0.1
	local lp = Players.LocalPlayer

	while true do
		RunService.Heartbeat:Wait()
		if hiddenfling then
			while hiddenfling and not (c and c.Parent and hrp and hrp.Parent) do
				RunService.Heartbeat:Wait()
				c = lp.Character
				hrp = c and c:FindFirstChild("HumanoidRootPart")
			end

			if hiddenfling then
				vel = hrp.Velocity
				hrp.Velocity = vel * 10000 + Vector3.new(0, 10000, 0)
				RunService.RenderStepped:Wait()
				if c and c.Parent and hrp and hrp.Parent then
					hrp.Velocity = vel
				end
				RunService.Stepped:Wait()
				if c and c.Parent and hrp and hrp.Parent then
					hrp.Velocity = vel + Vector3.new(0, movel, 0)
					movel = movel * -1
				end
			end
		end
	end
end

-- Start fling function
task.spawn(fling)

