-- Player reference
local plr = Players.LocalPlayer

-- Position saving configuration
local CONFIG_FILE = "KeystrokeUIPos.txt"
local savedPositions = {}

-- Load saved positions
if isfile and isfile(CONFIG_FILE) then
	local success, result = pcall(function()
		return HttpService:JSONDecode(readfile(CONFIG_FILE))
	end)
	if success and type(result) == "table" then
		savedPositions = result
	end
end

-- Save positions function
local function saveConfig()
	if writefile then
		writefile(CONFIG_FILE, HttpService:JSONEncode(savedPositions))
	end
end

-- Script identification
local SCRIPT_NAME = "Keystroke UI"
local UI_NAME = "KeystrokeUI"
local DETECTION_NAME = "keystroke_ui_detection"

-- Global UI stacking system
local function getOrCreateUIStack()
	local stackFolder = ReplicatedStorage:FindFirstChild("UIStackFolder")
	if not stackFolder then
		stackFolder = Instance.new("Folder")
		stackFolder.Name = "UIStackFolder"
		stackFolder.Parent = ReplicatedStorage
	end
	return stackFolder
end

-- Check if UI is already running (reload detection)
local existingGui = CoreGui:FindFirstChild(UI_NAME)
local existingDetection = getOrCreateUIStack():FindFirstChild(DETECTION_NAME)
local uiStack = getOrCreateUIStack()

if existingGui or existingDetection then
	-- UI is already running - move existing UIs down and show warning
	warn("⚠️ " .. SCRIPT_NAME .. " is already running! Creating new instance and moving existing ones down.")
	
	-- Count existing UIs to determine offset
	local existingCount = 0
	for _, child in pairs(uiStack:GetChildren()) do
		if child:IsA("StringValue") then
			existingCount = existingCount + 1
		end
	end
	
	-- Move all existing UIs down
	local offsetY = 140 * existingCount  -- 140px spacing between UIs
	for _, gui in pairs(CoreGui:GetChildren()) do
		if gui:IsA("ScreenGui") and (gui.Name == UI_NAME or gui.Name:find("KeystrokeUI")) then
			local frame = gui:FindFirstChild("Frame")
			if frame then
				local currentPos = frame.Position
				frame.Position = UDim2.new(currentPos.X.Scale, currentPos.X.Offset, currentPos.Y.Scale, currentPos.Y.Offset + offsetY)
			end
		end
	end
	
	-- Show warning notification
	if plr and plr:FindFirstChild("PlayerGui") then
		local notificationGui = Instance.new("ScreenGui")
		notificationGui.Name = UI_NAME .. "_Warning_" .. tostring(existingCount + 1)
		notificationGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		notificationGui.Parent = plr.PlayerGui
		
		local notificationFrame = Instance.new("Frame")
		notificationFrame.Size = UDim2.new(0, 400, 0, 120)
		notificationFrame.Position = UDim2.new(0.5, -200, 0.1 + (existingCount * 0.15), 0)
		notificationFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
		notificationFrame.BackgroundTransparency = 0.2
		notificationFrame.BorderSizePixel = 0
		notificationFrame.Parent = notificationGui
		
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 8)
		corner.Parent = notificationFrame
		
		local stroke = Instance.new("UIStroke")
		stroke.Color = Color3.fromRGB(255, 100, 100)
		stroke.Thickness = 2
		stroke.Parent = notificationFrame
		
		local title = Instance.new("TextLabel")
		title.Size = UDim2.new(1, -20, 0, 30)
		title.Position = UDim2.new(0, 10, 0, 10)
		title.BackgroundTransparency = 1
		title.Text = "⚠️ UI Already Running"
		title.TextColor3 = Color3.fromRGB(255, 100, 100)
		title.Font = Enum.Font.GothamBold
		title.TextSize = 16
		title.TextXAlignment = Enum.TextXAlignment.Left
		title.Parent = notificationFrame
		
		local message = Instance.new("TextLabel")
		message.Size = UDim2.new(1, -20, 0, 70)
		message.Position = UDim2.new(0, 10, 0, 40)
		message.BackgroundTransparency = 1
		message.Text = SCRIPT_NAME .. " is already active.\nExisting UI moved down.\nThis instance will be created below."
		message.TextColor3 = Color3.fromRGB(255, 255, 255)
		message.Font = Enum.Font.Gotham
		message.TextSize = 12
		message.TextXAlignment = Enum.TextXAlignment.Left
		message.TextWrapped = true
		message.Parent = notificationFrame
		
		-- Auto-remove after 5 seconds
		task.spawn(function()
			task.wait(5)
			notificationGui:Destroy()
		end)
	end
	
	-- Create new detection marker for this instance
	local newDetection = Instance.new("StringValue")
	newDetection.Name = DETECTION_NAME .. "_" .. tostring(existingCount + 1)
	newDetection.Value = SCRIPT_NAME
	newDetection.Parent = uiStack
end

-- Create detection marker for this instance
local detection = Instance.new("StringValue")
detection.Name = DETECTION_NAME
detection.Value = SCRIPT_NAME
detection.Parent = uiStack

-- Calculate position offset if there are existing UIs (before creating new UI)
local existingCountForOffset = 0
for _, child in pairs(uiStack:GetChildren()) do
	if child:IsA("StringValue") and child.Name ~= DETECTION_NAME then
		existingCountForOffset = existingCountForOffset + 1
	end
end
local positionOffset = existingCountForOffset * 140  -- 140px spacing

-- UI Elements
local ScreenGui = Instance.new("ScreenGui")
local instanceNumber = (existingGui or existingDetection) and (existingCountForOffset + 1) or 1
ScreenGui.Name = UI_NAME .. (instanceNumber > 1 and "_" .. tostring(instanceNumber) or "")
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.Enabled = true  -- Always visible, cannot be hidden
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = CoreGui

local Frame = Instance.new("Frame")
Frame.Parent = ScreenGui
Frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
Frame.BackgroundTransparency = 0.4
Frame.BorderSizePixel = 0
