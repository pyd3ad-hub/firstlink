if savedPositions["KeystrokeUI_Frame"] then
	local posData = savedPositions["KeystrokeUI_Frame"]
	Frame.Position = UDim2.new(posData.Xs, posData.Xo, posData.Ys, posData.Yo + positionOffset)
else
	Frame.Position = UDim2.new(0.5, -60, 0.5, -60 + positionOffset)  -- Centered with offset
end
Frame.Size = UDim2.new(0, 120, 0, 120)
Frame.Active = true  -- for dragging

local UICorner = Instance.new("UICorner")
